# Razorpay Test Mode Credentials
# Leave dummy or fill your actual test credentials from dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_123

# Anthropic Claude API Key (Optional: fallback engine is built-in if no key provided)
ANTHROPIC_API_KEY=

# Policy & Guardrails Defaults
DEFAULT_MAX_AUTONOMOUS_DISCOUNT=10.0
DEFAULT_MAX_CAMPAIGN_BUDGET=25000.0

# Database
DATABASE_URL=sqlite:///./revenue_system.db
